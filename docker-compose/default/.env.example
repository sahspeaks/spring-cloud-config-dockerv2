# Copy to .env and fill in real values:  cp .env.example .env

# RabbitMQ user, created by the rabbitmq container and used by every service
RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me

# Config server key for /encrypt, /decrypt and {cipher} values in config-repo.
# Changing it means re-encrypting every {cipher} value.
ENCRYPT_KEY=change-me

# MySQL: root password for accounts-db / loans-db / cards-db, also used by the services to connect
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
